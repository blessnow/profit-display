# 登录：ADMIN 凭证；API 请求头 Authorization: Positions <base64(user:pass)>（非浏览器 Basic，避免缓存导致无法登出）
# 未设置 ADMIN_PASS 时默认用户 holder / 密码 HoldSync_2026
ADMIN_USER=holder
ADMIN_PASS=

# SQLite 路径（可选）。Railway 持久化请挂 Volume，例如：
# POSITIONS_DB_PATH=/data/positions.db
# POSITIONS_DB_PATH=./data/positions.db

# 监听地址（默认 0.0.0.0，便于容器/Railway）
# LISTEN_HOST=0.0.0.0

# 初始 JSON（可选）
# SEED_JSON_PATH=./original_accounts.json

# —— 现价（TuShare rt_k 与 URL 模板二选一或并存；名称 JSON 仍可叠加）
# TuShare Pro：token 必填；HTTP 根地址可选（自建/代理），默认 https://api.tushare.pro
# TUSHARE_TOKEN=
# TUSHARE_HTTP_URL=http://127.0.0.1:8010
#
# 定时拉价时段（上海，工作日），HH:MM；默认早盘 09:10–11:30、午盘 13:00–15:50（午休不拉）
# QUOTE_SYNC_AM_START=09:10
# QUOTE_SYNC_AM_END=11:30
# QUOTE_SYNC_PM_START=13:00
# QUOTE_SYNC_PM_END=15:50

# —— 现价 URL 模板（未配 TUSHARE_TOKEN 时用；URL 由你配置，勿把密钥提交到公开仓库）
#
# A1）Yahoo Finance v8 chart（推荐，免东财）：占位 {{symbol}} 如 600519.SS / 000001.SZ
# QUOTE_PRICE_URL=https://query1.finance.yahoo.com/v8/finance/chart/{{symbol}}?interval=1d&range=5d
#
# A2）东方财富：占位 {{secid}} 如 1.600519
# QUOTE_PRICE_URL=https://push2.eastmoney.com/api/qt/stock/get?secid={{secid}}&fields=f43,f57,f58
QUOTE_PRICE_URL=

# 日 K 回填 + 资产曲线：回溯近若干上海自然日（默认 14≈两周；范围 3～60）
# SNAPSHOT_HISTORY_CALENDAR_DAYS=14

# —— 日 K（二选一）
#
# B1）Yahoo：{{symbol}} + {{period1}}{{period2}}（Unix 秒，由服务端从 beg/end 自动生成）
# QUOTE_KLINE_URL=https://query1.finance.yahoo.com/v8/finance/chart/{{symbol}}?period1={{period1}}&period2={{period2}}&interval=1d&includePrePost=false
#
# B2）东财：{{secid}} {{beg}} {{end}}（YYYYMMDD）
# QUOTE_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get?fields1=f1,f2,f3,f4,f5,f6,f7,f8,f9,f10,f11,f12,f13&fields2=f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61&ut=fa5fd1943c7b386f172d6893dbfba10b&klt=101&fqt=1&secid={{secid}}&beg={{beg}}&end={{end}}
QUOTE_KLINE_URL=

# —— 方式 C：GET 返回名称->价格 JSON（旧版）
# { "prices": { "国泰集团": 13.87 } }
QUOTE_SYNC_URL=

# 联想搜索（可选）：占位符 {{q}}，返回东方财富 suggest 兼容 JSON
# QUOTE_SUGGEST_URL=https://searchadapter.eastmoney.com/api/suggest/get?input={{q}}&type=14&token=你的token
QUOTE_SUGGEST_URL=

# 可选：部分行情接口需要；原样写入 Authorization
QUOTE_SYNC_AUTH_HEADER=
# 可选：HTTP User-Agent（Yahoo 等建议用常见浏览器 UA）
# QUOTE_HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 设为 1 则关闭定时拉行情
QUOTE_SYNC_DISABLED=0

# 定时拉价：下午段在 15:00 后再延长若干分钟（上海），便于接口返回收盘价；0～60，默认 15
# QUOTE_SESSION_EXTEND_MIN_AFTER_1500=15

# 日快照冻结总资产/市值：相对 15:00（上海）再延后多少分钟（盘后）；默认与上一项相同；可单独加大（0～120），且不会早于拉价结束
# SNAPSHOT_FREEZE_DELAY_MIN_AFTER_1500=15
